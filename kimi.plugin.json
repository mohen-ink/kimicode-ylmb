{
  "name": "kimi-code-usage",
  "version": "3.1.0",
  "description": "Kimi Code 用量面板：侧栏实时卡片 + 全屏报表 + 模型能力管理，桌面端内一体化",
  "author": "Kimi Code Community",
  "license": "MIT",
  "keywords": ["usage", "tokens", "cost", "dashboard", "models", "quota"],
  "skills": "./skills/",
  "commands": "./commands/",
  "systemPromptPath": "./SYSTEM.md",
  "sessionStart": {
    "skill": "kimi-code-usage"
  },
  "hooks": [
    {
      "event": "SessionStart",
      "command": ".\\scripts\\bootstrap.cmd",
      "timeout": 15
    },
    {
      "event": "SessionHeartbeat",
      "command": ".\\scripts\\bootstrap.cmd",
      "timeout": 15
    },
    {
      "event": "Stop",
      "command": ".\\scripts\\bootstrap.cmd",
      "timeout": 15
    },
    {
      "event": "SessionEnd",
      "command": ".\\scripts\\bootstrap.cmd",
      "timeout": 15
    }
  ],
  "interface": {
    "displayName": "Kimi Code 用量面板",
    "shortDescription": "侧栏实时用量卡片、全屏报表、模型能力开关与官方配额监控",
    "longDescription": "从本地会话日志采集每一次模型调用的真实用量（含缓存创建），聚合为今日/昨日/本周/本月/累计、逐小时、30 天明细、会话排行与模型分布；侧栏卡片常驻桌面端，点击展开全屏报表；附模型能力管理（识图/思考/工具/强度档位）与官方配额配速预警。所有采集与注入均由插件 hook 驱动，无需任何桌面脚本。",
    "developerName": "Kimi Code Community"
  }
}
